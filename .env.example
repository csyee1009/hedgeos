# HedgeOS Environment Configuration Example
# Copy this file to .env and configure environment variables.

PORT=3001
BASE_RPC_URL=https://mainnet.base.org

# AI Intent Provider Configuration
INTENT_PROVIDER=real
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Security & CORS Configuration
HEDGEOS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database & Storage
HEDGEOS_DB_PATH=data/hedgeos.sqlite

# Optional Offline / Demo Modes
FORCE_DEV_INTENT_PROVIDER=false
DEMO_SNAPSHOT_MODE=false
